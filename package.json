{
  "name": "slicemaster-desktop",
  "version": "3.0.0",
  "description": "Offline Pizza Shop POS and ERP Desktop Application",
  "author": "SliceMaster",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "start": "electron .",
    "build:renderer": "vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "npm run build:renderer && npm run rebuild && electron-builder --win nsis",
    "build:dir": "npm run build:renderer && npm run rebuild && electron-builder --dir",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('release',{recursive:true,force:true})\""
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "^9.2.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.slicemaster.desktop",
    "productName": "SliceMaster POS ERP",
    "directories": { "output": "release" },
    "asar": true,
    "npmRebuild": true,
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SliceMaster POS ERP"
    }
  }
}